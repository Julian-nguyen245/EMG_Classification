# ══════════════════════════════════════════════════════════════════════
#  .gitignore — EMG Gesture Classification Project
#  Chỉ track: code Python, C++, LaTeX, config, requirements
# ══════════════════════════════════════════════════════════════════════

# ── Dữ liệu lớn và tài liệu PDF (không track) ────────────────────────
Data (Ninapro)/raw/
Data (Ninapro)/s4/
Data (Ninapro)/processed/*.csv
!Data (Ninapro)/processed/.gitkeep

Books/
Papers/

dummy_sessions/
emg_hoang/*.png
emg_hoang/*.csv

session_*.csv

# ── Model weights & normalization stats ───────────────────────────────
src/weights/*.pth
src/weights/*.npz
src /weights/*.pth
src /weights/*.npz

# ── Outputs (figures, JSON) ───────────────────────────────────────────
outputs/
outputs_dummy/

# ── Python cache ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.mypy_cache/

# ── Jupyter ───────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Virtual environments ──────────────────────────────────────────────
venv/
env/
.env
.venv/
conda-env/

# ── IDE / OS ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# ── LaTeX / Written Book ──────────────────────────────────────────────
Written_Book/

# ── Misc ──────────────────────────────────────────────────────────────
*.egg-info/
dist/
build/
*.log
run
.sixth/
.claude/
CHANGES.md
